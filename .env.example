# ==============================================================================
# NutriScan AI Healthcare Platform — Environment Configuration Template
# Copy this file to .env and configure values before deploying to production.
# NEVER commit raw .env files with production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Environment & Identity
# ------------------------------------------------------------------------------
# Options: "development", "staging", "production"
ENVIRONMENT=development
PROJECT_NAME="NutriScan AI Healthcare Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"
PORT=8000

# ------------------------------------------------------------------------------
# 2. Database Architecture (Dual-Engine: PostgreSQL & SQLite)
# ------------------------------------------------------------------------------
# Options: "auto" (defaults to postgres if reachable, fallback to sqlite), "postgresql", "sqlite"
DATABASE_ENGINE=auto

# PostgreSQL Connection Strings (Async SQLAlchemy & Sync Psycopg2)
# Production Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://nutriscan_admin:nutriscan_secure_pass_2026@localhost:5432/nutriscan_db

# PostgreSQL Credentials for Container & Migration Management
POSTGRES_USER=nutriscan_admin
POSTGRES_PASSWORD=nutriscan_secure_pass_2026
POSTGRES_DB=nutriscan_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 3. Redis Distributed Engine (Token Denylist, Rate Limiting & Caching)
# ------------------------------------------------------------------------------
# Redis Connection URL (Falls back to thread-safe in-memory maps if unreachable)
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_TIMEOUT_SEC=2.0

# ------------------------------------------------------------------------------
# 4. Security & Cryptographic Tokens
# ------------------------------------------------------------------------------
# CRITICAL: In production, generate a 64+ char random secret (e.g. `openssl rand -hex 32`)
# Startup validation enforces minimum 32 characters in production mode.
JWT_SECRET=super_secret_jwt_key_phase1_screening_2026_production_grade_token_must_be_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 5. CORS & Network Ingress Security
# ------------------------------------------------------------------------------
# Comma-separated list of allowed web origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://nutriscan.vercel.app

# ------------------------------------------------------------------------------
# 6. Observability & Telemetry
# ------------------------------------------------------------------------------
# Options: "DEBUG", "INFO", "WARNING", "ERROR"
LOG_LEVEL=INFO
ENABLE_STRUCTURED_JSON_LOGS=true
METRICS_ENABLED=true

# ------------------------------------------------------------------------------
# 7. Disaster Recovery & Automated Backups
# ------------------------------------------------------------------------------
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true
